FROM runpod/worker-comfyui:5.10.0-base

USER root

RUN apt-get update \
    && apt-get install -y --no-install-recommends git curl ffmpeg ca-certificates build-essential python3.12-dev fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

RUN rm -rf /comfyui/custom_nodes/ComfyUI-LTXVideo \
    && git clone --depth 1 https://github.com/Lightricks/ComfyUI-LTXVideo.git /comfyui/custom_nodes/ComfyUI-LTXVideo \
    && /opt/venv/bin/python -m pip install --no-cache-dir -r /comfyui/custom_nodes/ComfyUI-LTXVideo/requirements.txt \
    && /opt/venv/bin/python -m pip install --no-cache-dir "kornia==0.8.2" "transformers>=4.50.0,<5" "fastapi>=0.115,<1"

COPY patch_freevideo_modal.py /tmp/patch_freevideo_modal.py

ARG FREEVIDEO_COMMIT=f7d117726a60567639dda7bba05ae353e58f7b97
RUN rm -rf /opt/freevideo \
    && git clone https://github.com/FlashML-org/FreeVideo.git /opt/freevideo \
    && git -C /opt/freevideo checkout "$FREEVIDEO_COMMIT" \
    && /opt/venv/bin/python /tmp/patch_freevideo_modal.py \
    && rm /tmp/patch_freevideo_modal.py \
    && chmod +x /opt/freevideo/freevideo /opt/freevideo/setup.sh

COPY extra_model_paths.yaml /comfyui/extra_model_paths.yaml
COPY handler.py /h3_baseline_handler.py
COPY freevideo_backend.py /freevideo_backend.py
COPY h3_ref2va_backend.py /h3_ref2va_backend.py
COPY h3_ref2va_generation.py /h3_ref2va_generation.py
COPY h3-setup.sh /h3-setup.sh
COPY ltx25_workflow.py /ltx25_workflow.py
COPY workflow_compiler.py /workflow_compiler.py
COPY h3_addons.py /h3_addons.py
COPY h3_context_store.py /h3_context_store.py
COPY h3_addon_handler.py /h3_addon_handler.py
COPY audio_features.py /audio_features.py
COPY mirrorvision_renderer.py /mirrorvision_renderer.py
COPY mirrorvision_dispatch.py /mirrorvision_dispatch.py
COPY mirrorvision_dispatch.py /handler.py
COPY mirrorvision_cpu_check.py /mirrorvision_cpu_check.py
COPY tests/ltx25-t2v-smoke-request.json /ltx25-t2v-template.json

# mirrorvision_dispatch imports this exact compatibility name.  The copied
# module retains every v136 H3 route and adds the native renderer additively.
RUN cp /h3_addon_handler.py /h3_addon_handler_existing.py \
    && chmod +x /h3-setup.sh \
    && PYTHONPATH=/ /opt/venv/bin/python -m py_compile \
       /handler.py /mirrorvision_dispatch.py /h3_baseline_handler.py /h3_addon_handler.py \
       /mirrorvision_renderer.py /audio_features.py /freevideo_backend.py \
       /h3_ref2va_backend.py /h3_ref2va_generation.py /ltx25_workflow.py \
       /workflow_compiler.py \
    && CUDA_VISIBLE_DEVICES= PYTHONPATH=/ /opt/venv/bin/python /mirrorvision_cpu_check.py

ENV PATH=/opt/venv/bin:$PATH
ENV PYTHONPATH=/
ENV NETWORK_VOLUME_DEBUG=false
ENV MIRRORVIDGEN_POLL_INTERVAL=1
ENV MIRRORVIDGEN_POLL_TIMEOUT=3500
ENV MIRRORVIDGEN_MAX_INLINE_VIDEO_BYTES=15000000
ENV FREEVIDEO_SOURCE=/opt/freevideo
ENV FREEVIDEO_ALLOW_RSS_GUARD=1
ENV FREEVIDEO_PYTHON=/opt/venv/bin/python
ENV FREEVIDEO_UV_LINK_MODE=copy
ENV FREEVIDEO_USE_PIP=1
ENV FREEVIDEO_HOME=/runpod-volume/freevideo-h3
ENV FREEVIDEO_HF_HOME=/runpod-volume/.cache/huggingface
ENV MIRRORVIDGEN_H3_RESULTS=/runpod-volume/results
ENV MIRRORVIDGEN_MODEL_ROOT=/runpod-volume/models
ENV MIRRORVIDGEN_COMFY_INPUT=/comfyui/input
ENV MIRRORVIDGEN_H3_TIMEOUT=3500
ENV MIRRORVISION_SITE_ORIGIN=https://mirrorvidgen-modal-preview.mitm1.chatgpt.site

