FROM ghcr.io/mitm-1/mirrorvidgen-worker@sha256:e575065ed15288a764e620c85a8ad9fa87493790daa78bb5b65812f8539a780d

USER root
RUN apt-get update && apt-get install -y --no-install-recommends fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

RUN cp /handler.py /h3_addon_handler_existing.py
COPY audio_features.py /audio_features.py
COPY mirrorvision_renderer.py /mirrorvision_renderer.py
COPY mirrorvision_dispatch.py /mirrorvision_dispatch.py
RUN cp /mirrorvision_dispatch.py /handler.py
COPY mirrorvision_cpu_check.py /mirrorvision_cpu_check.py

RUN /opt/venv/bin/python -m py_compile /handler.py /mirrorvision_renderer.py /audio_features.py /mirrorvision_cpu_check.py
ENV MIRRORVISION_SITE_ORIGIN=https://mirrorvidgen.mitm1.chatgpt.site

